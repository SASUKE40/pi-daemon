{
  "name": "@edward40/pi-daemon",
  "version": "0.1.21",
  "description": "Long-running Pi coding agent with a mobile web UI secured by Tailscale Serve or Cloudflare Access",
  "author": "Edward Evans <sasuke688848@gmail.com>",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SASUKE40/pi-daemon.git"
  },
  "homepage": "https://github.com/SASUKE40/pi-daemon#readme",
  "bugs": {
    "url": "https://github.com/SASUKE40/pi-daemon/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-daemon": "dist/cli.js",
    "pi-daemon-sessiond": "dist/sessiond.js",
    "pi-daemon-web": "dist/web.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "public",
    "installer",
    "compatibility.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist public coverage release",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "dev:sessiond": "tsx src/sessiond.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start:web": "node dist/web.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "fastify": "5.11.2",
    "jose": "6.1.0",
    "marked": "18.0.5",
    "qrcode-terminal": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0",
    "typebox": "1.3.10",
    "web-push": "3.6.7",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "undici": "8.9.0"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": true,
    "fsevents": false,
    "protobufjs": true
  },
  "publishConfig": {
    "access": "public"
  }
}
